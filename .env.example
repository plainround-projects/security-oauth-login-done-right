# Copy to .env (make up does it the first time). Every value here is a throwaway for an identity provider that lives
# on this machine while its container runs; change them if you share the machine. No real secret belongs in this file.

# The identity provider container (Keycloak, development mode).
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-only-admin-password
DEMO_USER_PASSWORD=local-only-demo-user-password

# The application (a confidential client registered as notes-app with exactly one redirect URI).
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=0
OIDC_ISSUER=http://localhost:8180/realms/demo
OIDC_CLIENT_ID=notes-app
OIDC_CLIENT_SECRET=local-only-client-secret-change-me
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_ALLOWED_EXTRA_SCOPES=reports:read
OIDC_HTTP_TIMEOUT_SECONDS=10

# Browsers treat http://localhost as secure, so the Secure cookie works there (Safari is the exception: use Chrome or
# Firefox, or put a TLS proxy in front). Refused when APP_ENV=production.
COOKIE_SECURE=true

# Session lifetimes in seconds and the access-token refresh margin.
SESSION_IDLE_SECONDS=900
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_ATTEMPT_TTL_SECONDS=600
ACCESS_TOKEN_REFRESH_MARGIN_SECONDS=30
